---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import '../styles/styles.scss';
---

<Layout>
	<Navbar />

<div class="grey-bg"></div>
<div class="image-content image-content-offset">
    <h1 class="project-hero-title">Type Foundry</h1>
    <div class="redact-wrapper redact-wrapper--full-frame">
		<img src="/images/typess1.gif" alt="Redactive type animation" />
	</div>
 </div>
<div class="type-text">
	<a class="nav-pill-link" href="https://redactype.com" target="_blank" rel="noopener noreferrer"><span class="arrow" aria-hidden="true">&rarr;</span><span>redactype.com</span></a>
	<p>An interactive type foundry showcasing redactive variable typefaces. Includes original as well as remixed fonts.</p>
	<p>Developed and designed with html and css. All typefaces made using Glyphs 3.</p>
</div>
<div class="image-content image-content-offset">
    <div class="foundry-wrapper"><img src="/images/foundry.gif" alt="type foundry" /></div>
</div>
</Layout>
