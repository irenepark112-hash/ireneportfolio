---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import '../styles/styles.scss';
---

<Layout>
	<Navbar />

	<div class="image-slider-wrapper">
	<div class="image-slider">
		<div class="slider-track">
			<div class="slide"><img src="/images/wino_foundry.webp" alt="winogrand" /></div>
			<div class="slide"><img src="/images/bed4.webp" alt="bed" /></div>
			<!-- <div class="slide"><img src="/images/foundry_landing.gif" alt="type foundry" /></div> -->
			<div class="slide"><img src="/images/researchrepo.gif" alt="research repository" /></div>
			<!-- <div class="slide"><img src="/images/foid.webp" alt="alternate internet archive" /></div> -->
			<div class="slide"><img src="/images/chess5.webp" alt="lettered entities" /></div>
			<div class="slide"><img src="/images/IMG_5482.webp" alt="interview" /></div>
			<div class="slide"><img src="/images/ode_landing.png" alt="ode to the book" /></div>
			<div class="slide"><img src="/images/p&p_cover.png" alt="p&p" /></div>
		</div>
		<div class="slider-next-area"></div>
	</div>
	</div>

	<script>
		const track = document.querySelector('.slider-track') as HTMLElement;
		const nextArea = document.querySelector('.slider-next-area') as HTMLElement;
		const slides = document.querySelectorAll('.slide');
		let currentIndex = 0;
		const totalSlides = slides.length;

		function updateSlider() {
			track.style.transform = `translateX(-${currentIndex * 80}vw)`;
		}

		nextArea.addEventListener('click', () => {
			if (currentIndex < totalSlides - 1) {
				currentIndex++;
				updateSlider();
			}
		});
	</script>
</Layout>
