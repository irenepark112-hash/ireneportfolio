---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import '../styles/styles.scss';
---

<Layout>
	<Navbar />

	<div class="image-slider-wrapper">
	<div class="image-slider">
		<div class="slider-track">
			<div class="slide"><img src="/images/wino_foundry.webp" alt="winogrand" loading="eager" /></div>
			<div class="slide"><img src="/images/bed4.webp" alt="bed" loading="eager" /></div>
			<!-- <div class="slide"><img src="/images/foundry_landing.gif" alt="type foundry" loading="lazy" /></div> -->
			<!-- <div class="slide"><img src="/images/researchrepo.gif" alt="research repository" loading="lazy" /></div> -->
			<!-- <div class="slide"><img src="/images/foid.webp" alt="alternate internet archive" loading="lazy" /></div> -->
			<div class="slide"><img src="/images/chess5.webp" alt="lettered entities" loading="lazy" /></div>
			<div class="slide"><img src="/images/IMG_5482.webp" alt="interview" loading="lazy" /></div>
			<div class="slide"><img src="/images/ode_landing.png" alt="ode to the book" loading="lazy" /></div>
			<div class="slide"><img src="/images/p&p_cover.png" alt="p&p" loading="lazy" /></div>
		</div>
		<div class="slider-next-area"><span>&rarr;</span></div>
	</div>
	</div>

	<script>
		const track = document.querySelector('.slider-track') as HTMLElement;
		const nextArea = document.querySelector('.slider-next-area') as HTMLElement;
		const originalSlides = Array.from(document.querySelectorAll('.slide'));
		const totalOriginal = originalSlides.length;
		let currentIndex = 0;
		let isTransitioning = false;

		// Clone the first 2 slides and append to the end for seamless looping
		for (let i = 0; i < 2; i++) {
			const clone = originalSlides[i].cloneNode(true) as HTMLElement;
			clone.classList.add('clone');
			const img = clone.querySelector('img') as HTMLImageElement;
			if (img) img.loading = 'lazy';
			track.appendChild(clone);
		}

		function updateSlider(animate = true) {
			if (!animate) track.style.transition = 'none';
			track.style.transform = `translateX(-${currentIndex * 80}vw)`;
			track.setAttribute('data-index', String(currentIndex % totalOriginal));
			if (!animate) track.offsetHeight; // force reflow
			if (!animate) track.style.transition = '';
		}

		track.addEventListener('transitionend', () => {
			isTransitioning = false;
			if (currentIndex >= totalOriginal) {
				currentIndex = currentIndex - totalOriginal;
				updateSlider(false);
			}
		});

		nextArea.addEventListener('click', () => {
			if (isTransitioning) return;
			isTransitioning = true;
			currentIndex++;
			updateSlider();

			// Preload upcoming image
			const preloadIdx = (currentIndex + 2) % totalOriginal;
			const img = originalSlides[preloadIdx].querySelector('img') as HTMLImageElement;
			if (img) img.loading = 'eager';
		});
	</script>
</Layout>
