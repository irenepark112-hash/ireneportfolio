	// Blur background when hovering over navbar text
	const navbarLinks = document.querySelectorAll('.navbar a');
	const imageSlider = document.querySelector('.image-slider');

	if (imageSlider) {
		navbarLinks.forEach(link => {
			link.addEventListener('mouseenter', () => {
				imageSlider.classList.add('blurred');
			});
			link.addEventListener('mouseleave', () => {
				imageSlider.classList.remove('blurred');
			});
		});
	}

	// Make About/Contact button fills continue forward on mouseleave
	const navButtons = document.querySelectorAll<HTMLAnchorElement>(
		'.about-link, .contact-link, .nav-pill-link'
	);

	navButtons.forEach(button => {
		button.addEventListener('mouseenter', () => {
			button.classList.remove('is-sweeping-out');
			button.classList.add('is-sweeping-in');
		});

		button.addEventListener('mouseleave', () => {
			button.classList.remove('is-sweeping-in');
			button.classList.add('is-sweeping-out');
		});

		button.addEventListener('animationend', (e) => {
			const animationEvent = e as AnimationEvent;
			if (animationEvent.animationName === 'button-fill-out') {
				button.classList.remove('is-sweeping-out');
			}
		});
	});
</script>
